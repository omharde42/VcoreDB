# Database
DATABASE_URL=postgresql://localhost:5432/vcoredb
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL_MODE=prefer

# Application runtime
NODE_ENV=development
LOG_LEVEL=info

# Authentication (Phase 2 placeholders)
AUTH_PASSWORD_HASH_ALGORITHM=argon2id
AUTH_PASSWORD_PEPPER=replace_with_a_long_random_string
AUTH_SESSION_TOKEN_PEPPER=replace_with_a_long_random_string
AUTH_EMAIL_VERIFICATION_TOKEN_PEPPER=replace_with_a_long_random_string
AUTH_PASSWORD_RESET_TOKEN_PEPPER=replace_with_a_long_random_string
AUTH_SESSION_TTL_HOURS=720
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=1440
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_REVOKED_SESSION_RETENTION_DAYS=30

# Audit/telemetry toggles
AUDIT_LOGGING_ENABLED=true
METRICS_ENABLED=true
