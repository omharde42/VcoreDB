# Database
DATABASE_URL=postgresql://localhost:5432/vcoredb
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL_MODE=prefer

# Application runtime
NODE_ENV=development
LOG_LEVEL=info

# Security/auth (future phases)
AUTH_JWT_SECRET=replace_with_a_long_random_string
AUTH_REFRESH_TOKEN_SECRET=replace_with_a_long_random_string

# API credential controls (future phases)
API_KEY_HASH_PEPPER=replace_with_a_long_random_string

# Audit/telemetry toggles
AUDIT_LOGGING_ENABLED=true
METRICS_ENABLED=true
